---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@/styles/tailwind.css';
import { analyticsConfig } from '../data/analytics';
import { generateWebsiteSchema } from '../utils/structuredData';
import { getAlternatePath, type Locale } from '../utils/i18n';

export interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  dir?: 'ltr' | 'rtl';
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  lang = 'ar',
  dir = lang === 'ar' ? 'rtl' : 'ltr',
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteName = 'Abdla';
const fullPageTitle = `${title} | ${siteName}`;
const siteUrl = 'https://abdla.box';
const currentUrl = `${siteUrl}${Astro.url.pathname}`;

const defaultDescription =
  lang === 'ar'
    ? 'الواجهة الرقمية لـ عبدالله: مقالات وتجارب في التقنية، الذكاء الاصطناعي، الجري، وإدارة المعرفة.'
    : 'Technology Consultant and Runner sharing insights on tech, AI, productivity, and personal growth.';
const siteDescription = description || defaultDescription;

const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : `${siteUrl}/web-app-manifest-512x512.png`;

const alternatePath = await getAlternatePath(Astro.url.pathname, lang);
const enUrl = lang === 'en' ? currentUrl : `${siteUrl}${alternatePath}`;
const arUrl = lang === 'ar' ? currentUrl : `${siteUrl}${alternatePath}`;

const websiteSchema = generateWebsiteSchema();
---
<!DOCTYPE html>
<html lang={lang} dir={dir} class="font-sans antialiased">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Prevent dark-mode flash (FOUC) before first paint -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Primary Meta Tags -->
  <title>{fullPageTitle}</title>
  <meta name="title" content={fullPageTitle} />
  <meta name="description" content={siteDescription} />
  <meta name="author" content="Abdla" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={currentUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={fullPageTitle} />
  <meta property="og:description" content={siteDescription} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={currentUrl} />
  <meta name="twitter:title" content={fullPageTitle} />
  <meta name="twitter:description" content={siteDescription} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <meta name="theme-color" content="#0EA5E9" />
  <meta name="msapplication-TileColor" content="#0EA5E9" />

  <!-- Hreflang (per-page accurate links) -->
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="ar" href={arUrl} />
  <link rel="alternate" hreflang="x-default" href={arUrl} />

  <!-- RSS Feeds -->
  <link rel="alternate" type="application/rss+xml" title={`${siteName} Blog (AR)`} href={`${siteUrl}/ar/rss.xml`} />
  <link rel="alternate" type="application/rss+xml" title={`${siteName} Blog (EN)`} href={`${siteUrl}/rss.xml`} />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

  <!-- Google Analytics -->
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsConfig.googleAnalytics.id}`}></script>
  <script define:vars={{ gaId: analyticsConfig.googleAnalytics.id }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', gaId);
  </script>

  <!-- Microsoft Clarity -->
  <script type="text/javascript" define:vars={{ clarityId: analyticsConfig.clarity.projectId }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
  </script>

  <!-- Fonts (trimmed to only active brand families) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Vazirmatn:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
  <link href="/fonts/fonts.css" rel="stylesheet" />

  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <Header lang={lang} />
  <main class="flex-grow py-8 md:py-12">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>

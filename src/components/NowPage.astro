---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { nowData } from '../data/now';
import type { Locale } from '../utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';
const pageTitle = isAr ? 'الآن' : 'Now';
const pageDescription = nowData.intro[locale];
---

<BaseLayout title={pageTitle} description={pageDescription} lang={locale} dir={isAr ? 'rtl' : 'ltr'}>
  <div class="container mx-auto max-w-3xl px-4 md:px-6 py-10 md:py-14">
    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-400/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>
          {isAr ? `آخر تحديث: ${nowData.lastUpdated.ar}` : `Last updated: ${nowData.lastUpdated.en}`}
        </span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-3">
        {isAr ? 'ماذا أفعل الآن؟' : "What I'm Doing Now"}
      </h1>
      <p class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {nowData.intro[locale]}
      </p>
    </header>

    <div class="space-y-5">
      {nowData.sections.map((section) => (
        <section class="bento-card">
          <div class="flex items-center gap-3 mb-4">
            <span class="bento-icon bg-sky-50 dark:bg-sky-500/15 text-electric-blue dark:text-electric-blue-light">
              <Icon name={section.icon} class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{section.title[locale]}</h2>
          </div>
          <ul class="space-y-3">
            {section.items.map((item) => (
              <li class="flex items-start gap-2.5 text-sm md:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-electric-blue flex-shrink-0" aria-hidden="true"></span>
                <span>{item[locale]}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="mt-10 pt-6 border-t border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 text-sm text-zinc-500 dark:text-zinc-400">
      <a
        href={`/${locale}/signals/`}
        class="hover:text-electric-blue dark:hover:text-electric-blue-light transition-colors"
      >
        {isAr ? 'تصفح الإشارات السريعة ←' : 'Browse quick Signals →'}
      </a>
      <a
        href={`/${locale}/contact/`}
        class="font-semibold text-electric-blue dark:text-electric-blue-light hover:underline"
      >
        {isAr ? 'أرسل إشارة ←' : 'Send a Signal →'}
      </a>
    </div>
  </div>
</BaseLayout>

---
import { imageManager } from '../utils/imageUpload';

export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const {
  src,
  alt,
  width = 800,
  height,
  class: className = '',
  loading = 'lazy',
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
} = Astro.props;

const isR2Image = src.startsWith('r2://');
const imagePath = isR2Image ? src.replace(/^r2:\/\//, '') : src;

const optimizedSrc = isR2Image
  ? imageManager.getOptimizedImageUrl(imagePath, {
      width,
      height,
      format: 'auto',
      quality: 85,
    })
  : src;

const srcSet =
  isR2Image && imageManager.isTransformEnabled
    ? [400, 800, 1200, 1600]
        .map(
          (size) =>
            `${imageManager.getOptimizedImageUrl(imagePath, { width: size, format: 'auto' })} ${size}w`
        )
        .join(', ')
    : undefined;
---

<img
  src={optimizedSrc}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
  sizes={srcSet ? sizes : undefined}
  srcset={srcSet}
/>

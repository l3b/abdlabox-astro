---
import { getAlternatePath, type Locale } from '../utils/i18n';
import { Icon } from 'astro-icon/components';

export interface Props {
  lang?: Locale;
}

const currentPath = Astro.url.pathname;
const currentLocale: Locale =
  Astro.props.lang ||
  (Astro.currentLocale === 'en' ? 'en' : currentPath.startsWith('/en') ? 'en' : 'ar');

const siteTitle = 'Abdla';
const alternateLocaleName = currentLocale === 'en' ? 'العربية' : 'English';
const alternatePath = await getAlternatePath(currentPath, currentLocale);

const navLinks = [
  { name: currentLocale === 'en' ? 'Base' : 'الواجهة', href: `/${currentLocale}/`, isHome: true },
  { name: currentLocale === 'en' ? 'Blog' : 'المدونة', href: `/${currentLocale}/blog/`, isHome: false },
  { name: currentLocale === 'en' ? 'Behind the Dunes?' : 'من وراء الكثبان؟', href: `/${currentLocale}/about/`, isHome: false },
  { name: currentLocale === 'en' ? 'Send a Signal' : 'أرسل إشارة', href: `/${currentLocale}/contact/`, isHome: false },
];

const normalizedPath = currentPath.replace(/\/+$/, '') || '/';
---
<header class="header-top">
  <div class="container mx-auto flex flex-wrap items-center justify-between p-4 gap-x-6 gap-y-2">
    <div class="site-title text-2xl font-bold tracking-tight">
      <a href={`/${currentLocale}/`} class="hover:text-neon-yellow transition-colors duration-200">{siteTitle}</a>
    </div>

    <button
      id="menuButton"
      type="button"
      aria-label={currentLocale === 'en' ? 'Toggle navigation menu' : 'فتح القائمة'}
      aria-expanded="false"
      aria-controls="navMenu"
      class="md:hidden text-cool-light-gray hover:text-neon-yellow"
    >
      <Icon name="mdi:menu" class="w-6 h-6" />
    </button>

    <nav id="navMenu" class="hidden w-full md:flex md:w-auto md:gap-8 text-base items-center">
      <div class="flex flex-col md:flex-row gap-4 md:gap-8 mt-4 md:mt-0 md:items-center">
        {navLinks.map((link) => {
          const normalizedHref = link.href.replace(/\/+$/, '') || '/';
          const isActive = link.isHome
            ? normalizedPath === normalizedHref || (currentLocale === 'ar' && normalizedPath === '/')
            : normalizedPath === normalizedHref || normalizedPath.startsWith(`${normalizedHref}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'pb-1 border-b-2 transition-colors duration-200',
                isActive
                  ? 'border-neon-yellow text-neon-yellow'
                  : 'border-transparent hover:border-neon-yellow/70 hover:text-cool-light-gray/80',
              ]}
            >
              {link.name}
            </a>
          );
        })}
        {!currentPath.includes('/tags/') && (
          <a
            href={alternatePath}
            class={`px-3 py-1 rounded-full border border-white/30 text-white hover:bg-white hover:text-electric-blue transition-all duration-200 text-sm font-medium self-start md:self-auto ${currentLocale === 'en' ? 'font-arabic-body' : ''}`}
            title={alternateLocaleName}
          >
            {currentLocale === 'en' ? 'عربي' : 'EN'}
          </a>
        )}
        <button
          id="themeToggle"
          type="button"
          aria-label={currentLocale === 'en' ? 'Toggle dark mode' : 'تبديل الوضع الداكن'}
          class="md:ms-2 self-start md:self-auto hover:text-neon-yellow transition-colors"
        >
          <Icon name="mdi:theme-light-dark" class="w-6 h-6" />
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('menuButton');
  const navMenu = document.getElementById('navMenu');

  menuButton?.addEventListener('click', () => {
    const isHidden = navMenu?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!isHidden));
  });

  document.getElementById('themeToggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>

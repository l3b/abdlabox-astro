---
import { getAlternatePath, type Locale } from '../utils/i18n';
import { Icon } from 'astro-icon/components';

export interface Props {
  lang?: Locale;
}

const currentPath = Astro.url.pathname;
const currentLocale: Locale =
  Astro.props.lang ||
  (Astro.currentLocale === 'en' ? 'en' : currentPath.startsWith('/en') ? 'en' : 'ar');
const isAr = currentLocale === 'ar';

const alternateLocaleName = isAr ? 'English' : 'العربية';
const alternatePath = await getAlternatePath(currentPath, currentLocale);

const navLinks = [
  { name: isAr ? 'الواجهة' : 'Base', href: `/${currentLocale}/`, isHome: true },
  { name: isAr ? 'المدونة' : 'Blog', href: `/${currentLocale}/blog/`, isHome: false },
  { name: isAr ? 'إشارات' : 'Signals', href: `/${currentLocale}/signals/`, isHome: false },
  { name: isAr ? 'الجري' : 'Running', href: `/${currentLocale}/running/`, isHome: false },
  { name: isAr ? 'الآن' : 'Now', href: `/${currentLocale}/now/`, isHome: false },
  { name: isAr ? 'عنّي' : 'About', href: `/${currentLocale}/about/`, isHome: false },
  { name: isAr ? 'تواصل' : 'Contact', href: `/${currentLocale}/contact/`, isHome: false },
];

const normalizedPath = currentPath.replace(/\/+$/, '') || '/';
---

<header class="header-glass">
  <div class="container mx-auto max-w-6xl px-4 md:px-6 h-16 flex items-center justify-between gap-4">
    {/* Wordmark */}
    <div class="site-title text-xl md:text-2xl font-bold tracking-tight flex-shrink-0">
      <a
        href={`/${currentLocale}/`}
        class="inline-flex items-baseline text-zinc-900 dark:text-white hover:text-electric-blue dark:hover:text-electric-blue-light transition-colors"
      >
        Abdla<span class="text-electric-blue dark:text-neon-yellow">.</span>
      </a>
    </div>

    {/* Desktop Nav */}
    <nav class="hidden lg:flex items-center gap-1" aria-label={isAr ? 'التنقل الرئيسي' : 'Main Navigation'}>
      {navLinks.map((link) => {
        const normalizedHref = link.href.replace(/\/+$/, '') || '/';
        const isActive = link.isHome
          ? normalizedPath === normalizedHref || (isAr && normalizedPath === '/')
          : normalizedPath === normalizedHref || normalizedPath.startsWith(`${normalizedHref}/`);
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'px-3 py-1.5 rounded-lg text-sm transition-colors',
              isActive
                ? 'bg-sky-50 dark:bg-sky-500/15 text-sky-700 dark:text-sky-300 font-semibold'
                : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100/80 dark:hover:bg-zinc-800/70',
            ]}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    {/* Right Actions: ⌘K, Language, Theme, Mobile Menu */}
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-cmdk
        aria-label={isAr ? 'بحث سريع' : 'Quick search'}
        class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-900/80 text-zinc-500 dark:text-zinc-400 hover:border-electric-blue/50 hover:text-zinc-900 dark:hover:text-white transition-colors text-xs"
      >
        <Icon name="mdi:magnify" class="w-4 h-4" />
        <span class="hidden sm:inline">{isAr ? 'بحث' : 'Search'}</span>
        <kbd class="hidden md:inline-flex px-1 py-0.2 rounded bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 font-mono text-[10px]">
          ⌘K
        </kbd>
      </button>

      {!currentPath.includes('/tags/') && (
        <a
          href={alternatePath}
          class={`px-2.5 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-electric-blue hover:text-electric-blue dark:hover:text-electric-blue-light transition-colors text-xs font-medium ${!isAr ? 'font-arabic-body' : ''}`}
          title={alternateLocaleName}
        >
          {isAr ? 'EN' : 'عربي'}
        </a>
      )}

      <button
        id="themeToggle"
        type="button"
        aria-label={isAr ? 'تبديل الوضع الداكن' : 'Toggle dark mode'}
        class="p-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-white transition-colors"
      >
        <Icon name="mdi:theme-light-dark" class="w-5 h-5" />
      </button>

      <button
        id="menuButton"
        type="button"
        aria-label={isAr ? 'فتح القائمة' : 'Toggle navigation menu'}
        aria-expanded="false"
        aria-controls="mobileMenu"
        class="lg:hidden p-2 rounded-lg text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <Icon name="mdi:menu" class="w-5 h-5" />
      </button>
    </div>
  </div>

  {/* Mobile Dropdown Drawer */}
  <nav
    id="mobileMenu"
    class="hidden lg:hidden border-t border-zinc-200/70 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-xl px-4 py-3"
    aria-label={isAr ? 'قائمة الجوال' : 'Mobile Navigation'}
  >
    <div class="grid grid-cols-2 gap-1.5">
      {navLinks.map((link) => {
        const normalizedHref = link.href.replace(/\/+$/, '') || '/';
        const isActive = link.isHome
          ? normalizedPath === normalizedHref || (isAr && normalizedPath === '/')
          : normalizedPath === normalizedHref || normalizedPath.startsWith(`${normalizedHref}/`);
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'px-3 py-2 rounded-xl text-sm transition-colors',
              isActive
                ? 'bg-sky-50 dark:bg-sky-500/15 text-sky-700 dark:text-sky-300 font-semibold'
                : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800',
            ]}
          >
            {link.name}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  function initHeader() {
    const menuButton = document.getElementById('menuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    const themeToggle = document.getElementById('themeToggle');

    if (menuButton && mobileMenu) {
      menuButton.onclick = () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        menuButton.setAttribute('aria-expanded', String(!isHidden));
      };
    }

    if (themeToggle) {
      themeToggle.onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

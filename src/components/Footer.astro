---
import { Icon } from 'astro-icon/components';
import { footerSocialLinks } from '../data/socialLinks';
import { getAlternatePath, type Locale } from '../utils/i18n';

export interface Props {
  lang?: Locale;
}

const currentPath = Astro.url.pathname;
const currentLocale: Locale =
  Astro.props.lang ||
  (Astro.currentLocale === 'en' ? 'en' : currentPath.startsWith('/en') ? 'en' : 'ar');
const isAr = currentLocale === 'ar';
const alternatePath = await getAlternatePath(currentPath, currentLocale);

const navLinks = isAr
  ? [
      { name: 'الواجهة', url: '/ar/' },
      { name: 'المدونة', url: '/ar/blog/' },
      { name: 'إشارات', url: '/ar/signals/' },
      { name: 'الجري', url: '/ar/running/' },
      { name: 'الآن', url: '/ar/now/' },
      { name: 'عنّي', url: '/ar/about/' },
      { name: 'تواصل', url: '/ar/contact/' },
    ]
  : [
      { name: 'Base', url: '/en/' },
      { name: 'Blog', url: '/en/blog/' },
      { name: 'Signals', url: '/en/signals/' },
      { name: 'Running', url: '/en/running/' },
      { name: 'Now', url: '/en/now/' },
      { name: 'About', url: '/en/about/' },
      { name: 'Contact', url: '/en/contact/' },
    ];
---

<footer class="mt-auto border-t border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-950/70 backdrop-blur-sm">
  <div class="container mx-auto max-w-6xl px-4 md:px-6 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-5">
      <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
        {navLinks.map((link) => (
          <a
            href={link.url}
            class="text-zinc-600 dark:text-zinc-400 hover:text-electric-blue dark:hover:text-electric-blue-light transition-colors"
          >
            {link.name}
          </a>
        ))}
        <a
          href={isAr ? '/ar/rss.xml' : '/rss.xml'}
          class="text-zinc-500 dark:text-zinc-500 hover:text-electric-blue dark:hover:text-electric-blue-light transition-colors inline-flex items-center gap-1"
          title="RSS"
        >
          <Icon name="mdi:rss" class="w-4 h-4" />
          <span>RSS</span>
        </a>
      </nav>

      <div class="flex items-center gap-3">
        {footerSocialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="p-1.5 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-electric-blue dark:hover:text-electric-blue-light hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
            title={link.name}
            aria-label={link.name}
          >
            <Icon name={link.icon} class="w-4 h-4" />
          </a>
        ))}

        <span class="h-4 w-px bg-zinc-200 dark:bg-zinc-800 mx-1" aria-hidden="true"></span>

        <button
          id="theme-toggle-footer"
          type="button"
          class="p-1.5 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-zinc-600 dark:text-zinc-400"
          aria-label={isAr ? 'تبديل الوضع الداكن' : 'Toggle dark mode'}
        >
          <Icon name="mdi:theme-light-dark" class="w-4 h-4" />
        </button>

        <a
          href={alternatePath}
          class="px-2.5 py-1 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-xs font-medium text-zinc-600 dark:text-zinc-400"
        >
          {isAr ? 'EN' : 'عربي'}
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooterTheme() {
    const btn = document.getElementById('theme-toggle-footer');
    if (btn) {
      btn.onclick = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };
    }
  }
  document.addEventListener('astro:page-load', initFooterTheme);
</script>

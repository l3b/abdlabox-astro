---
import { fetchRunningStats, ANNUAL_RUNNING_GOAL_KM } from '../utils/intervalsApi';
import { PROFILES } from '../data/socialLinks';
import { Icon } from 'astro-icon/components';
import EmptyState from './EmptyState.astro';

export interface Props {
  locale?: 'ar' | 'en';
}

const locale: 'ar' | 'en' = Astro.props.locale || (Astro.currentLocale === 'en' ? 'en' : 'ar');
const isAr = locale === 'ar';
const stats = await fetchRunningStats(locale);

const formatDistance = (distance: number) => (isAr ? `${distance} كم` : `${distance} km`);
const remainingKm = stats
  ? Math.max(0, Math.round((ANNUAL_RUNNING_GOAL_KM - stats.thisYear.distance) * 10) / 10)
  : ANNUAL_RUNNING_GOAL_KM;
---

{stats ? (
  <div class="space-y-4">
    {/* Annual Goal + Live Streak */}
    <div class="bg-gradient-to-br from-electric-blue/5 via-teal/5 to-lime/10 dark:from-electric-blue/15 dark:via-teal/10 dark:to-lime/10 rounded-xl p-4 border border-electric-blue/20 dark:border-electric-blue/30">
      <div class="flex items-center justify-between gap-2 mb-2">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200">
          {isAr ? 'هدف السنة' : 'Annual Goal'}
        </h3>
        <div class="flex items-center gap-2">
          {stats.streakDays >= 2 && (
            <span
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300"
              title={isAr ? 'سلسلة أيام جري متتالية' : 'Consecutive running days'}
            >
              🔥 {isAr ? `${stats.streakDays} أيام متتالية` : `${stats.streakDays}-day streak`}
            </span>
          )}
          <span class="text-xs text-gray-500 dark:text-gray-400">
            {isAr ? `${stats.thisYear.runs} جريات` : `${stats.thisYear.runs} runs`}
          </span>
        </div>
      </div>

      <div class="mb-2.5">
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold text-electric-blue dark:text-electric-blue-light">
            {formatDistance(stats.thisYear.distance)}
          </span>
          <span class="text-sm text-gray-500 dark:text-gray-400">
            {isAr ? `من ${ANNUAL_RUNNING_GOAL_KM} كم` : `of ${ANNUAL_RUNNING_GOAL_KM} km`}
          </span>
        </div>
      </div>

      <div class="relative">
        <div class="h-2.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div
            class="h-full bg-gradient-to-r from-electric-blue via-teal to-lime rounded-full transition-all duration-500"
            style={`width: ${stats.thisYear.progress}%`}
          />
        </div>
        <div class="flex justify-between items-center mt-1.5 text-xs text-gray-500 dark:text-gray-400">
          <span>{isAr ? `${stats.thisYear.progress}% مكتمل` : `${stats.thisYear.progress}% complete`}</span>
          <span>
            {remainingKm === 0
              ? (isAr ? 'تم تحقيق الهدف! 🎉' : 'Goal smashed! 🎉')
              : (isAr ? `باقي ${remainingKm} كم` : `${remainingKm} km to go`)}
          </span>
        </div>
      </div>

      <p class="mt-2.5 pt-2 border-t border-gray-200/60 dark:border-gray-700/60 text-[11px] text-gray-600 dark:text-gray-300">
        🏃‍♂️ {stats.thisYear.funFact}
      </p>
    </div>

    {/* This Week & This Month */}
    <div class="grid grid-cols-2 gap-3">
      <div class="bg-white/60 dark:bg-gray-800/50 rounded-lg p-3 border border-gray-200 dark:border-gray-700">
        <h4 class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">
          {isAr ? 'هذا الأسبوع' : 'This Week'}
        </h4>
        <p class="text-lg font-bold text-soft-charcoal dark:text-gray-100">
          {formatDistance(stats.thisWeek.distance)}
        </p>
        <p class="text-[11px] text-gray-500 dark:text-gray-400">
          {isAr
            ? `${stats.thisWeek.runs} جريات • ${stats.thisWeek.timeMin} د`
            : `${stats.thisWeek.runs} runs • ${stats.thisWeek.timeMin} min`}
        </p>
      </div>

      <div class="bg-white/60 dark:bg-gray-800/50 rounded-lg p-3 border border-gray-200 dark:border-gray-700">
        <h4 class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">
          {isAr ? 'هذا الشهر' : 'This Month'}
        </h4>
        <p class="text-lg font-bold text-soft-charcoal dark:text-gray-100">
          {formatDistance(stats.thisMonth.distance)}
        </p>
        <p class="text-[11px] text-gray-500 dark:text-gray-400">
          {isAr
            ? `${stats.thisMonth.runs} جريات • ↑ ${stats.thisMonth.elevationM}م`
            : `${stats.thisMonth.runs} runs • ↑ ${stats.thisMonth.elevationM}m`}
        </p>
      </div>
    </div>

    {/* Recent Runs — each links straight to Strava */}
    {stats.recentActivities.length > 0 && (
      <div class="space-y-2.5">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300">
            {isAr ? 'آخر الجريات' : 'Latest Runs'}
          </h4>
          {stats.primaryWatch && (
            <span class="inline-flex items-center gap-1 text-[11px] text-gray-500 dark:text-gray-400">
              ⌚ {stats.primaryWatch}
            </span>
          )}
        </div>

        {stats.recentActivities.map((activity) => (
          <a
            href={activity.link}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white/50 dark:bg-gray-800/40 rounded-lg p-3 border border-gray-100 dark:border-gray-700/70 hover:border-electric-blue/40 hover:bg-white/80 dark:hover:bg-gray-800/70 transition-all group block"
          >
            <div class="flex items-start justify-between gap-2">
              <p class="text-sm font-semibold text-soft-charcoal dark:text-gray-100 group-hover:text-electric-blue dark:group-hover:text-electric-blue-light leading-snug">
                {activity.feelEmoji && <span class="me-1" aria-hidden="true">{activity.feelEmoji}</span>}
                {activity.name}
              </p>
              <div class="flex items-center gap-1 flex-shrink-0 text-[11px] text-gray-400 dark:text-gray-500">
                <span>{activity.date}</span>
                <Icon
                  name="mdi:open-in-new"
                  class="w-3 h-3 opacity-50 group-hover:opacity-100 transition-opacity"
                />
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-600 dark:text-gray-400 mt-2">
              <span class="inline-flex items-center gap-1 font-medium text-soft-charcoal dark:text-gray-200">
                <Icon name="mdi:map-marker-distance" class="w-3.5 h-3.5 text-electric-blue" />
                {formatDistance(activity.distance)}
              </span>
              <span class="inline-flex items-center gap-1">
                <Icon name="mdi:clock-outline" class="w-3.5 h-3.5 text-teal" />
                {activity.time}
              </span>
              <span class="inline-flex items-center gap-1">
                <Icon name="mdi:speedometer" class="w-3.5 h-3.5 text-lime" />
                {activity.pace}/km
              </span>
              {activity.avgHr && (
                <span class="inline-flex items-center gap-0.5 text-[11px]">
                  ❤️ {activity.avgHr}
                </span>
              )}
              {activity.elevationM && (
                <span class="inline-flex items-center gap-0.5 text-[11px]">
                  ⛰️ {activity.elevationM}m
                </span>
              )}
              {activity.cadenceSpm && (
                <span class="inline-flex items-center gap-0.5 text-[11px]">
                  ⚡ {activity.cadenceSpm} spm
                </span>
              )}
            </div>

            {activity.shoeName && (
              <div class="mt-2">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] bg-gray-100 dark:bg-gray-700/70 text-gray-600 dark:text-gray-300">
                  👟 {activity.shoeName}
                </span>
              </div>
            )}
          </a>
        ))}
      </div>
    )}

    {/* Shoe Rotation / Gear Closet */}
    {stats.shoes.length > 0 && (
      <div class="pt-2 border-t border-gray-200/70 dark:border-gray-700/70">
        <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 flex items-center gap-1.5">
          <span>👟</span>
          {isAr ? 'أحذية الجري' : 'Shoe Rotation'}
        </h4>
        <div class="space-y-2">
          {stats.shoes.map((shoe) => (
            <div class="text-xs">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="font-medium text-gray-700 dark:text-gray-200 truncate">
                  {shoe.name}
                </span>
                <span class="text-[11px] text-gray-500 dark:text-gray-400 flex-shrink-0">
                  {formatDistance(shoe.distanceKm)}
                </span>
              </div>
              <div class="h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                <div
                  class:list={[
                    'h-full rounded-full',
                    shoe.wearPercent >= 85
                      ? 'bg-coral'
                      : shoe.wearPercent >= 50
                        ? 'bg-electric-blue'
                        : 'bg-teal',
                  ]}
                  style={`width: ${shoe.wearPercent}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Profile Link */}
    <div class="flex items-center justify-between pt-1">
      <a
        href={PROFILES.strava.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-gray-500 dark:text-gray-400 hover:text-lavender dark:hover:text-lavender inline-flex items-center gap-1"
      >
        {isAr ? 'ملفي على Strava' : 'My Strava Profile'}
        <span aria-hidden="true">{isAr ? '←' : '→'}</span>
      </a>
      <span class="text-[10px] text-gray-400 dark:text-gray-500">
        Garmin • Intervals.icu
      </span>
    </div>
  </div>
) : (
  <EmptyState
    message={isAr ? 'لا تتوفر بيانات الجري حالياً' : 'Running stats currently unavailable'}
    icon="simple-icons:strava"
    locale={locale}
  />
)}

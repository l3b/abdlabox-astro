---
import { fetchRunningStats } from '../utils/intervalsApi';
import { Icon } from 'astro-icon/components';
import EmptyState from './EmptyState.astro';

export interface Props {
  locale?: 'ar' | 'en';
}

const locale: 'ar' | 'en' = Astro.props.locale || (Astro.currentLocale === 'en' ? 'en' : 'ar');
const isAr = locale === 'ar';
const stats = await fetchRunningStats(locale);

const formatDistance = (distance: number) => (isAr ? `${distance} كم` : `${distance} km`);
---

{stats ? (
  <div class="space-y-4">
    {/* Hero Summary: This Month + This Week + Streak + 4-Week Rhythm */}
    <div class="rounded-xl p-4 bg-gradient-to-br from-lime/10 via-teal/5 to-electric-blue/10 dark:from-lime/10 dark:via-teal/10 dark:to-electric-blue/15 border border-lime/25 dark:border-lime/20">
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300">
          {stats.thisMonth.monthName}
        </span>
        {stats.streakDays >= 2 && (
          <span
            class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300"
            title={isAr ? 'أيام جري متتالية' : 'Consecutive running days'}
          >
            🔥 {isAr ? `${stats.streakDays} أيام متتالية` : `${stats.streakDays}-day streak`}
          </span>
        )}
      </div>

      {/* Month & Week KPIs */}
      <div class="grid grid-cols-2 gap-3 pb-3.5 border-b border-gray-200/70 dark:border-gray-700/60">
        <div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mb-0.5">
            {isAr ? 'مسافة الشهر' : 'This Month'}
          </p>
          <p class="text-2xl font-bold text-soft-charcoal dark:text-white leading-tight">
            {formatDistance(stats.thisMonth.distance)}
          </p>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
            {isAr
              ? `${stats.thisMonth.runs} جريات • ↑ ${stats.thisMonth.elevationM}م`
              : `${stats.thisMonth.runs} runs • ↑ ${stats.thisMonth.elevationM}m`}
          </p>
        </div>

        <div class="ps-3 border-s border-gray-200/70 dark:border-gray-700/60">
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mb-0.5">
            {isAr ? 'هذا الأسبوع' : 'This Week'}
          </p>
          <p class="text-2xl font-bold text-electric-blue dark:text-electric-blue-light leading-tight">
            {formatDistance(stats.thisWeek.distance)}
          </p>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
            {isAr
              ? `${stats.thisWeek.runs} جريات • ${stats.thisWeek.timeMin} د`
              : `${stats.thisWeek.runs} runs • ${stats.thisWeek.timeMin} min`}
          </p>
        </div>
      </div>

      {/* 4-Week Rhythm Sparkline */}
      <div class="pt-3">
        <div class="flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400 mb-2">
          <span>{isAr ? 'إيقاع آخر 4 أسابيع' : '4-Week Rhythm'}</span>
        </div>
        <div class="grid grid-cols-4 gap-2 items-end h-14">
          {stats.weeklyBars.map((bar) => (
            <div class="flex flex-col items-center justify-end h-full gap-1">
              <span class="text-[10px] font-medium text-gray-500 dark:text-gray-400 leading-none">
                {bar.distanceKm}
              </span>
              <div class="w-full flex-1 flex items-end">
                <div
                  class:list={[
                    'w-full rounded-t-md transition-all',
                    bar.isCurrent
                      ? 'bg-gradient-to-t from-electric-blue to-teal'
                      : 'bg-gray-300/80 dark:bg-gray-700',
                  ]}
                  style={`height: ${bar.percent}%`}
                />
              </div>
            </div>
          ))}
        </div>
        <div class="grid grid-cols-4 gap-2 mt-1 text-center">
          {stats.weeklyBars.map((bar) => (
            <span
              class:list={[
                'text-[10px] truncate',
                bar.isCurrent
                  ? 'font-semibold text-electric-blue dark:text-electric-blue-light'
                  : 'text-gray-400 dark:text-gray-500',
              ]}
            >
              {bar.label}
            </span>
          ))}
        </div>
      </div>
    </div>

    {/* Latest Public Runs — each links straight to Strava */}
    {stats.recentActivities.length > 0 && (
      <div class="space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
          {isAr ? 'آخر الجريات' : 'Latest Runs'}
        </h3>

        {stats.recentActivities.map((activity) => (
          <a
            href={activity.link}
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-xl p-3 bg-gray-50/80 dark:bg-gray-800/50 border border-gray-200/70 dark:border-gray-700/60 hover:border-electric-blue/50 dark:hover:border-electric-blue-light/50 hover:bg-white dark:hover:bg-gray-800 transition-all group"
          >
            <div class="flex items-start justify-between gap-2">
              <p class="text-sm font-semibold text-soft-charcoal dark:text-gray-100 group-hover:text-electric-blue dark:group-hover:text-electric-blue-light leading-snug">
                {activity.feelEmoji && (
                  <span class="me-1" aria-hidden="true">
                    {activity.feelEmoji}
                  </span>
                )}
                {activity.name}
              </p>
              <span class="text-[11px] text-gray-400 dark:text-gray-500 flex-shrink-0 inline-flex items-center gap-1">
                {activity.date}
                <Icon
                  name="mdi:open-in-new"
                  class="w-3 h-3 opacity-40 group-hover:opacity-100 transition-opacity"
                />
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-600 dark:text-gray-400 mt-2">
              <span class="inline-flex items-center gap-1 font-semibold text-soft-charcoal dark:text-gray-100">
                <Icon name="mdi:map-marker-distance" class="w-3.5 h-3.5 text-electric-blue" />
                {formatDistance(activity.distance)}
              </span>
              <span class="inline-flex items-center gap-1">
                <Icon name="mdi:clock-outline" class="w-3.5 h-3.5 text-teal" />
                {activity.time}
              </span>
              <span class="inline-flex items-center gap-1">
                <Icon name="mdi:speedometer" class="w-3.5 h-3.5 text-lime" />
                {activity.pace}/km
              </span>
              {activity.avgHr && (
                <span class="inline-flex items-center gap-0.5 text-[11px]">
                  ❤️ {activity.avgHr}
                </span>
              )}
              {activity.elevationM && (
                <span class="inline-flex items-center gap-0.5 text-[11px]">
                  ⛰️ {activity.elevationM}m
                </span>
              )}
            </div>

            {activity.shoeName && (
              <div class="mt-2">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] bg-white dark:bg-gray-700/70 border border-gray-200/80 dark:border-gray-600/60 text-gray-600 dark:text-gray-300">
                  👟 {activity.shoeName}
                </span>
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
) : (
  <EmptyState
    message={isAr ? 'لا تتوفر بيانات الجري حالياً' : 'Running stats currently unavailable'}
    icon="mdi:run-fast"
    locale={locale}
  />
)}

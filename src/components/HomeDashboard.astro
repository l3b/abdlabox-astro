---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import OptimizedImage from './OptimizedImage.astro';
import RunningStats from './RunningStats.astro';
import EmptyState from './EmptyState.astro';
import { getHomeFeeds } from '../utils/feeds';
import { PROFILES } from '../data/socialLinks';
import type { Locale } from '../utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';
const arrow = isAr ? '←' : '→';

const copy = isAr
  ? {
      pageTitle: 'الواجهة',
      pageSubtitle: 'لقطة حيّة من عالمي الرقمي',
      pageDescription: 'الواجهة الرقمية لـ عبدالله: استكشاف الأفكار والتجارب عبر مختلف الإشارات.',
      blogHeading: 'أحدث ما في المدونة',
      blogEmpty: 'لا توجد مقالات حديثة حالياً',
      allPosts: 'كل المقالات',
      runHeading: 'الجري',
      runProfile: 'Strava',
      blueskyHeading: 'من Bluesky',
      blueskySharedLink: '[رابط مشترك]:',
      blueskyView: 'عرض المنشور',
      blueskyEmpty: 'لم يتم العثور على منشورات حديثة باللغة العربية',
      blueskyProfile: 'الملف',
      traktHeading: 'شاهدت مؤخرًا',
      traktEmpty: 'لم يتم العثور على سجل مشاهدة حديث',
      traktProfile: 'Trakt',
      goodreadsHeading: 'أقرأ الآن',
      goodreadsEmpty: 'لا يوجد كتب حاليًا',
      goodreadsProfile: 'Goodreads',
      githubHeading: 'من GitHub',
      githubEmpty: 'لا يوجد نشاط حديث',
      githubProfile: 'GitHub',
    }
  : {
      pageTitle: 'The Base',
      pageSubtitle: 'A live snapshot from my digital world',
      pageDescription:
        "Abdullah's digital interface: Exploring ideas and experiences across various signals.",
      blogHeading: 'Latest from the Blog',
      blogEmpty: 'No recent posts available',
      allPosts: 'All Posts',
      runHeading: 'Running',
      runProfile: 'Strava',
      blueskyHeading: 'From Bluesky',
      blueskySharedLink: '[Shared Link]:',
      blueskyView: 'View post',
      blueskyEmpty: 'No recent posts found',
      blueskyProfile: 'Profile',
      traktHeading: 'Recently Watched',
      traktEmpty: 'No recent watched history',
      traktProfile: 'Trakt',
      goodreadsHeading: 'Currently Reading',
      goodreadsEmpty: 'No books currently',
      goodreadsProfile: 'Goodreads',
      githubHeading: 'From GitHub',
      githubEmpty: 'No recent activity',
      githubProfile: 'GitHub',
    };

const [latestPosts, feeds] = await Promise.all([
  getCollection('blog', ({ data, slug }) => slug.startsWith(`${locale}/`) && data.isDraft !== true)
    .then((posts) =>
      posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3)
    )
    .catch((e) => {
      console.error(`Error fetching ${locale} blog posts:`, e);
      return [];
    }),
  getHomeFeeds(locale),
]);

const {
  currentlyReadingBooks,
  recentlyWatchedItems,
  latestBlueskyPosts,
  latestGitHubEvents,
} = feeds;

const formatPostDate = (date: Date) =>
  date.toLocaleDateString(isAr ? 'ar-SA' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout
  title={copy.pageTitle}
  description={copy.pageDescription}
  lang={locale}
  dir={isAr ? 'rtl' : 'ltr'}
>
  <div class="container mx-auto px-4 py-8 md:px-6 md:py-12 max-w-6xl">
    {/* Page Header */}
    <header class="text-center mb-10 md:mb-14">
      <h1 class="text-4xl md:text-5xl font-bold mb-3 text-soft-charcoal dark:text-white tracking-tight">
        {copy.pageTitle}
      </h1>
      <p class="text-base md:text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        {copy.pageSubtitle}
      </p>
    </header>

    {/* Bento Dashboard Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5 md:gap-6 items-start">
      {/* 1. Blog Widget (Featured) */}
      <section class="bento-card md:col-span-2 lg:col-span-7">
        <div class="bento-header">
          <div class="flex items-center gap-3">
            <span class="bento-icon bg-lavender/15 text-lavender">
              <Icon name="mdi:post-outline" class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{copy.blogHeading}</h2>
          </div>
          <a href={`/${locale}/blog/`} class="bento-action">
            {copy.allPosts} <span aria-hidden="true">{arrow}</span>
          </a>
        </div>

        {latestPosts.length > 0 ? (
          <div class="space-y-5">
            {latestPosts.map((post, idx) => {
              const postHref = `/${locale}/blog/${post.slug.replace(new RegExp(`^${locale}/`), '')}`;
              const isLead = idx === 0;
              return (
                <article class:list={[!isLead && 'pt-4 border-t border-gray-100 dark:border-gray-800']}>
                  {isLead && post.data.featuredImage && (
                    <a href={postHref} class="block mb-4 overflow-hidden rounded-xl group">
                      {post.data.featuredImage.r2Path ? (
                        <OptimizedImage
                          src={`r2://${post.data.featuredImage.r2Path}`}
                          alt={post.data.featuredImage.alt || post.data.title}
                          width={720}
                          height={360}
                          class="w-full h-52 md:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
                        />
                      ) : (
                        <img
                          src={post.data.featuredImage.url}
                          alt={post.data.featuredImage.alt || post.data.title}
                          loading="lazy"
                          decoding="async"
                          class="w-full h-52 md:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
                        />
                      )}
                    </a>
                  )}
                  <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500 mb-1.5">
                    <time>{formatPostDate(post.data.pubDate)}</time>
                    {post.data.tags && post.data.tags.slice(0, 2).map((tag) => (
                      <span class="px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-[11px]">
                        #{tag}
                      </span>
                    ))}
                  </div>
                  <h3 class:list={['font-semibold leading-snug mb-1.5', isLead ? 'text-xl' : 'text-base']}>
                    <a
                      href={postHref}
                      class="text-soft-charcoal dark:text-gray-100 hover:text-electric-blue dark:hover:text-electric-blue-light transition-colors"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  {post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed line-clamp-2">
                      {post.data.description}
                    </p>
                  )}
                </article>
              );
            })}
          </div>
        ) : (
          <EmptyState message={copy.blogEmpty} icon="mdi:post-outline" locale={locale} />
        )}
      </section>

      {/* 2. Running Widget */}
      <section class="bento-card md:col-span-2 lg:col-span-5">
        <div class="bento-header">
          <div class="flex items-center gap-3">
            <span class="bento-icon bg-lime/15 text-lime-600 dark:text-lime">
              <Icon name="mdi:run-fast" class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{copy.runHeading}</h2>
          </div>
          <a
            href={PROFILES.strava.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bento-action"
          >
            {copy.runProfile} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <RunningStats locale={locale} />
      </section>

      {/* 3. Bluesky Widget */}
      <section class="bento-card md:col-span-1 lg:col-span-6">
        <div class="bento-header">
          <div class="flex items-center gap-3">
            <span class="bento-icon bg-sky-500/15 text-sky-500">
              <Icon name="simple-icons:bluesky" class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{copy.blueskyHeading}</h2>
          </div>
          <a
            href={PROFILES.bluesky.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bento-action"
          >
            {copy.blueskyProfile} <span aria-hidden="true">↗</span>
          </a>
        </div>

        {latestBlueskyPosts.length > 0 ? (
          <div class="space-y-4">
            {latestBlueskyPosts.map((post) => (
              <div class="p-3.5 rounded-xl bg-gray-50/70 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 hover:border-sky-500/30 transition-colors">
                {post.embedImageUrl && (
                  <a
                    href={post.embedLinkUrl || post.postUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block mb-2.5 overflow-hidden rounded-lg"
                  >
                    <img
                      src={post.embedImageUrl}
                      alt={post.embedLinkTitle || 'Bluesky Embed Image'}
                      class="w-full max-h-48 object-cover border border-gray-200 dark:border-gray-700 rounded-lg"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                {post.text && (
                  <p class="text-soft-charcoal dark:text-gray-200 text-sm leading-relaxed mb-2 line-clamp-4">
                    {post.text}
                  </p>
                )}
                {!post.text && post.embedLinkTitle && post.embedLinkUrl && (
                  <p class="text-soft-charcoal dark:text-gray-200 text-sm leading-relaxed mb-2 line-clamp-3">
                    <em class="text-gray-500">{copy.blueskySharedLink}</em> {post.embedLinkTitle}
                  </p>
                )}
                <a
                  href={post.postUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-medium text-electric-blue dark:text-electric-blue-light hover:underline inline-flex items-center gap-1"
                >
                  {copy.blueskyView} <span aria-hidden="true">{arrow}</span>
                </a>
              </div>
            ))}
          </div>
        ) : (
          <EmptyState message={copy.blueskyEmpty} icon="simple-icons:bluesky" locale={locale} />
        )}
      </section>

      {/* 4. Trakt Recently Watched */}
      <section class="bento-card md:col-span-1 lg:col-span-6">
        <div class="bento-header">
          <div class="flex items-center gap-3">
            <span class="bento-icon bg-rose-500/15 text-rose-500">
              <Icon name="simple-icons:trakt" class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{copy.traktHeading}</h2>
          </div>
          <a
            href={PROFILES.trakt.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bento-action"
          >
            {copy.traktProfile} <span aria-hidden="true">↗</span>
          </a>
        </div>

        {recentlyWatchedItems.length > 0 ? (
          <ul class="space-y-3">
            {recentlyWatchedItems.map((item) => (
              <li>
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-3.5 p-2.5 rounded-xl bg-gray-50/70 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 hover:border-rose-500/30 transition-all group"
                >
                  {item.posterUrl && (
                    <img
                      src={item.posterUrl}
                      alt={item.title}
                      width="48"
                      height="72"
                      class="w-12 h-[4.5rem] object-cover rounded-lg shadow-sm flex-shrink-0 group-hover:scale-[1.03] transition-transform"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-soft-charcoal dark:text-gray-100 group-hover:text-electric-blue dark:group-hover:text-electric-blue-light leading-snug">
                      <span class="me-1" aria-hidden="true">
                        {item.type === 'movie' ? '🎬' : '📺'}
                      </span>
                      {item.title}
                    </p>
                    {item.overview && (
                      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mt-1 line-clamp-2">
                        {item.overview}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState message={copy.traktEmpty} icon="simple-icons:trakt" locale={locale} />
        )}
      </section>

      {/* 5. Goodreads Currently Reading */}
      <section class="bento-card md:col-span-1 lg:col-span-6">
        <div class="bento-header">
          <div class="flex items-center gap-3">
            <span class="bento-icon bg-teal/15 text-teal">
              <Icon name="simple-icons:goodreads" class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{copy.goodreadsHeading}</h2>
          </div>
          <a
            href={PROFILES.goodreads.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bento-action"
          >
            {copy.goodreadsProfile} <span aria-hidden="true">↗</span>
          </a>
        </div>

        {currentlyReadingBooks.length > 0 ? (
          <ul class="space-y-3">
            {currentlyReadingBooks.map((book) => (
              <li>
                <a
                  href={book.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3.5 p-2.5 rounded-xl bg-gray-50/70 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 hover:border-teal/40 transition-all group"
                >
                  {book.coverUrl && (
                    <img
                      src={book.coverUrl}
                      alt={book.title}
                      width="44"
                      height="66"
                      loading="lazy"
                      decoding="async"
                      class="w-11 h-16 object-cover rounded-md shadow-sm flex-shrink-0 group-hover:scale-[1.03] transition-transform"
                    />
                  )}
                  <p class="text-sm font-medium text-soft-charcoal dark:text-gray-100 group-hover:text-teal transition-colors leading-snug line-clamp-2">
                    {book.title}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState message={copy.goodreadsEmpty} icon="simple-icons:goodreads" locale={locale} />
        )}
      </section>

      {/* 6. GitHub Latest Activity */}
      <section class="bento-card md:col-span-1 lg:col-span-6">
        <div class="bento-header">
          <div class="flex items-center gap-3">
            <span class="bento-icon bg-electric-blue/15 text-electric-blue dark:text-electric-blue-light">
              <Icon name="simple-icons:github" class="w-5 h-5" />
            </span>
            <h2 class="bento-title">{copy.githubHeading}</h2>
          </div>
          <a
            href={PROFILES.github.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bento-action"
          >
            {copy.githubProfile} <span aria-hidden="true">↗</span>
          </a>
        </div>

        {latestGitHubEvents.length > 0 ? (
          <ul class="space-y-3">
            {latestGitHubEvents.map((event) => (
              <li class="relative ps-4 before:content-[''] before:absolute before:start-0 before:top-2 before:w-2 before:h-2 before:rounded-full before:bg-electric-blue/70">
                <a
                  href={event.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block group"
                >
                  <p class="text-sm text-soft-charcoal dark:text-gray-200 group-hover:text-electric-blue dark:group-hover:text-electric-blue-light transition-colors leading-relaxed">
                    {event.display}
                  </p>
                  <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-0.5">{event.timeAgo}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState message={copy.githubEmpty} icon="simple-icons:github" locale={locale} />
        )}
      </section>
    </div>
  </div>
</BaseLayout>

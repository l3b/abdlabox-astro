---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import EmptyState from './EmptyState.astro';
import type { Locale } from '../utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';

const rawSignals = (
  await getCollection('signals', ({ data }) => data.language === locale && data.isDraft !== true)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const renderedSignals = await Promise.all(
  rawSignals.map(async (sig) => ({
    sig,
    rendered: await sig.render(),
  }))
);

const categoryMeta: Record<string, { ar: string; en: string; badge: string }> = {
  all: { ar: 'الكل', en: 'All', badge: '' },
  tech: {
    ar: 'تقنية',
    en: 'Tech',
    badge: 'bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-500/15 dark:text-sky-200 dark:border-sky-400/30',
  },
  ai: {
    ar: 'ذكاء اصطناعي',
    en: 'AI',
    badge: 'bg-violet-50 text-violet-800 border-violet-200 dark:bg-violet-500/15 dark:text-violet-200 dark:border-violet-400/30',
  },
  running: {
    ar: 'جري',
    en: 'Running',
    badge: 'bg-lime-50 text-lime-800 border-lime-200 dark:bg-lime-500/15 dark:text-lime-200 dark:border-lime-400/30',
  },
  reading: {
    ar: 'قراءة',
    en: 'Reading',
    badge: 'bg-teal-50 text-teal-800 border-teal-200 dark:bg-teal-500/15 dark:text-teal-200 dark:border-teal-400/30',
  },
  life: {
    ar: 'حياة',
    en: 'Life',
    badge: 'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-500/15 dark:text-amber-200 dark:border-amber-400/30',
  },
};

const activeCategories = ['all', ...new Set(rawSignals.map((s) => s.data.category))];

const pageTitle = isAr ? 'إشارات' : 'Signals';
const pageSubtitle = isAr
  ? 'ملاحظات قصيرة، روابط تستحق المشاركة، وأفكار عابرة — بدون انتظار المقال الطويل.'
  : 'Short notes, worthwhile links, and quick thoughts — shipped without waiting for a long-form essay.';
---

<BaseLayout title={pageTitle} description={pageSubtitle} lang={locale} dir={isAr ? 'rtl' : 'ltr'}>
  <div class="container mx-auto max-w-3xl px-4 md:px-6 py-10 md:py-14">
    <header class="mb-8 md:mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-amber-50 dark:bg-amber-500/10 text-amber-800 dark:text-neon-yellow border border-amber-200/80 dark:border-amber-400/20 mb-4">
        <span>📡</span>
        <span>{isAr ? 'تحديثات سريعة' : 'Micro-stream'}</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-3">
        {pageTitle}
      </h1>
      <p class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {pageSubtitle}
      </p>
    </header>

    {/* Filter Pills */}
    {activeCategories.length > 2 && (
      <div class="flex flex-wrap gap-2 mb-8" id="signal-filters">
        {activeCategories.map((cat, idx) => (
          <button
            type="button"
            data-signal-filter={cat}
            class:list={[
              'px-3 py-1.5 rounded-full text-xs font-medium border transition-colors',
              idx === 0
                ? 'bg-zinc-900 text-white border-zinc-900 dark:bg-white dark:text-zinc-950 dark:border-white'
                : 'bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border-zinc-200 dark:border-zinc-800 hover:border-electric-blue',
            ]}
          >
            {categoryMeta[cat]?.[locale] || cat}
          </button>
        ))}
      </div>
    )}

    {renderedSignals.length > 0 ? (
      <div class="relative space-y-5 before:content-[''] before:absolute before:top-2 before:bottom-2 before:start-3 before:w-px before:bg-zinc-200 dark:before:bg-zinc-800">
        {renderedSignals.map(({ sig, rendered }) => {
          const { Content } = rendered;
          const cat = categoryMeta[sig.data.category] || categoryMeta.tech;
          return (
            <article
              data-signal-cat={sig.data.category}
              class="relative ps-9"
            >
              <span
                class="absolute start-[7px] top-6 w-2.5 h-2.5 rounded-full bg-electric-blue ring-4 ring-[#FAFAFA] dark:ring-[#09090B]"
                aria-hidden="true"
              />
              <div class="card">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                  <div class="flex items-center gap-2">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium border ${cat.badge}`}>
                      {cat[locale]}
                    </span>
                    <time class="text-xs text-zinc-500 dark:text-zinc-400">
                      {sig.data.pubDate.toLocaleDateString(isAr ? 'ar-SA' : 'en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  </div>
                </div>

                {sig.data.title && (
                  <h2 class="text-lg font-semibold text-zinc-900 dark:text-white mb-2">
                    {sig.data.title}
                  </h2>
                )}

                <div class="prose prose-sm md:prose-base max-w-none dark:prose-invert text-zinc-700 dark:text-zinc-300">
                  <Content />
                </div>

                {sig.data.link && (
                  <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800">
                    <a
                      href={sig.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-electric-blue dark:text-electric-blue-light hover:underline"
                    >
                      <Icon name="mdi:link-variant" class="w-4 h-4" />
                      {sig.data.linkLabel || sig.data.link}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <EmptyState
        message={isAr ? 'لا توجد إشارات منشورة بعد' : 'No signals published yet'}
        icon="mdi:broadcast"
        locale={locale}
      />
    )}
  </div>
</BaseLayout>

<script>
  function initSignalFilters() {
    const filterWrap = document.getElementById('signal-filters');
    if (!filterWrap) return;
    const buttons = filterWrap.querySelectorAll<HTMLButtonElement>('[data-signal-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-signal-cat]');

    buttons.forEach((btn) => {
      btn.onclick = () => {
        const selected = btn.dataset.signalFilter || 'all';
        buttons.forEach((b) => {
          const active = b === btn;
          b.className = `px-3 py-1.5 rounded-full text-xs font-medium border transition-colors ${
            active
              ? 'bg-zinc-900 text-white border-zinc-900 dark:bg-white dark:text-zinc-950 dark:border-white'
              : 'bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border-zinc-200 dark:border-zinc-800 hover:border-electric-blue'
          }`;
        });
        cards.forEach((card) => {
          const match = selected === 'all' || card.dataset.signalCat === selected;
          card.style.display = match ? '' : 'none';
        });
      };
    });
  }
  document.addEventListener('astro:page-load', initSignalFilters);
</script>

---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogTranslation } from '../../../utils/i18n';
import { generateBlogPostSchema } from '../../../utils/structuredData';
import { imageManager } from '../../../utils/imageUpload';
import { getReadingTime } from '../../../utils/readingTime';
import { normalizeTag } from '../../../data/tags';
import OptimizedImage from '../../../components/OptimizedImage.astro';

export async function getStaticPaths() {
  const allArabicPosts = await getCollection('blog', ({ data }) => {
    return data.language === 'ar' && data.isDraft !== true;
  });
  return allArabicPosts.map((post) => ({
    params: { slug: post.slug.replace(/^ar\//, '') },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();
const translatedPost = await getBlogTranslation(post);

const allPosts = await getCollection('blog', ({ data }) => data.language === 'ar' && !data.isDraft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const readingTime = getReadingTime(post.body);
const cleanSlug = post.slug.replace(/^ar\//, '');
const resolvedFeaturedImage = post.data.featuredImage?.r2Path
  ? imageManager.getR2ImageUrl(post.data.featuredImage.r2Path)
  : post.data.featuredImage?.url;

const blogPostSchema = generateBlogPostSchema(
  post.data.title,
  post.data.description,
  post.data.pubDate,
  post.data.updatedDate,
  cleanSlug,
  resolvedFeaturedImage,
  'ar'
);
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="ar"
  dir="rtl"
  ogImage={resolvedFeaturedImage}
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostSchema)}></script>

  <div class="container mx-auto px-4 py-8 md:px-6 md:py-12">
    <article>
      <header class="mb-8 border-b border-gray-300 dark:border-gray-700 pb-6">
        <h1 class="inline-block text-3xl md:text-4xl font-bold mb-3 text-soft-charcoal pb-2 border-b-2 border-b-neon-yellow">
          {post.data.title}
        </h1>

        <div class="text-sm text-gray-600 flex flex-wrap items-center gap-x-4 gap-y-2 mt-3">
          <span>
            نُشر في:{' '}
            {post.data.pubDate.toLocaleDateString('ar-SA', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
          <span>• وقت القراءة: {readingTime} دقيقة</span>
          {translatedPost && (
            <a
              href={`/en/blog/${translatedPost.slug.replace(/^en\//, '')}`}
              class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full border border-electric-blue/40 text-electric-blue hover:bg-electric-blue hover:text-white transition-colors text-xs font-medium"
            >
              Read in English →
            </a>
          )}
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex items-center gap-1.5 flex-wrap mt-3 text-sm text-gray-600">
            <span>تصنيفات:</span>
            {post.data.tags.map((tag) => (
              <a href={`/ar/tags/${normalizeTag(tag)}`} class="tag">
                {tag}
              </a>
            ))}
          </div>
        )}

        {post.data.featuredImage && (
          <figure class="mt-6">
            {post.data.featuredImage.r2Path ? (
              <OptimizedImage
                src={`r2://${post.data.featuredImage.r2Path}`}
                alt={post.data.featuredImage.alt}
                width={800}
                height={400}
                loading="eager"
                class="w-full h-auto rounded-lg shadow-lg"
              />
            ) : (
              <img
                src={post.data.featuredImage.url}
                alt={post.data.featuredImage.alt}
                class="w-full h-auto rounded-lg shadow-lg"
              />
            )}
            {post.data.featuredImage.caption && (
              <figcaption class="text-center text-gray-600 mt-2 text-sm">
                {post.data.featuredImage.caption}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      {(prevPost || nextPost) && (
        <nav class="flex justify-between mb-8 text-sm">
          {nextPost && (
            <a href={`/ar/blog/${nextPost.slug.replace(/^ar\//, '')}`} class="text-teal-600 hover:text-lavender">
              ← {nextPost.data.title}
            </a>
          )}
          {prevPost && (
            <a href={`/ar/blog/${prevPost.slug.replace(/^ar\//, '')}`} class="text-teal-600 hover:text-lavender mr-auto">
              {prevPost.data.title} →
            </a>
          )}
        </nav>
      )}

      <div
        class="prose prose-lg max-w-none mt-8 prose-headings:font-semibold prose-headings:text-soft-charcoal prose-p:text-soft-charcoal prose-p:leading-relaxed prose-a:text-teal-600 prose-a:underline hover:prose-a:text-lavender prose-strong:text-soft-charcoal prose-strong:font-semibold prose-blockquote:border-r-electric-blue prose-blockquote:border-l-0 prose-blockquote:pr-4 prose-blockquote:pl-0 prose-blockquote:italic prose-li:marker:text-electric-blue prose-pre:bg-soft-charcoal prose-pre:text-gray-200 prose-pre:p-4 prose-pre:rounded-lg prose-pre:overflow-x-auto dark:prose-invert dark:prose-headings:text-cool-light-gray dark:prose-p:text-gray-300 dark:prose-strong:text-cool-light-gray dark:prose-a:text-teal dark:hover:prose-a:text-lavender dark:prose-blockquote:border-r-teal dark:prose-li:marker:text-teal dark:prose-pre:bg-gray-800/80 dark:prose-pre:text-gray-200"
      >
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizeTag } from '../../data/tags';
import { getReadingTime } from '../../utils/readingTime';
import OptimizedImage from '../../components/OptimizedImage.astro';

const allEnglishPosts = await getCollection('blog', ({ data }) => {
  return data.language === 'en' && data.isDraft !== true;
});

const sortedPosts = allEnglishPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageTitle = 'Blog';
const pageDescription =
  'Articles and notes on Technology, AI, Knowledge Management, Running, and more.';
---

<BaseLayout title={pageTitle} description={pageDescription} lang="en" dir="ltr">
  <div class="container mx-auto max-w-4xl px-4 md:px-6 py-10 md:py-14">
    <header class="mb-10">
      <h1 class="text-3xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-3">
        {pageTitle}
      </h1>
      <p class="text-base md:text-lg text-zinc-600 dark:text-zinc-400">{pageDescription}</p>
    </header>

    <div class="space-y-6">
      {sortedPosts.map((post) => {
        const postHref = `/en/blog/${post.slug.replace(/^en\//, '')}`;
        const readMin = getReadingTime(post.body);
        return (
          <article class="card group">
            <div class="flex flex-col md:flex-row gap-5">
              {post.data.featuredImage && (
                <a href={postHref} class="w-full md:w-52 flex-shrink-0 overflow-hidden rounded-xl block">
                  {post.data.featuredImage.r2Path ? (
                    <OptimizedImage
                      src={`r2://${post.data.featuredImage.r2Path}`}
                      alt={post.data.featuredImage.alt || post.data.title}
                      width={420}
                      height={260}
                      class="w-full h-48 md:h-36 object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    />
                  ) : (
                    <img
                      src={post.data.featuredImage.url}
                      alt={post.data.featuredImage.alt || post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-48 md:h-36 object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    />
                  )}
                </a>
              )}
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 mb-2">
                  <time>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  <span>•</span>
                  <span>{readMin} min read</span>
                </div>

                <a href={postHref} class="block mb-2">
                  <h2 class="text-xl md:text-2xl font-semibold text-zinc-900 dark:text-white group-hover:text-electric-blue dark:group-hover:text-electric-blue-light transition-colors">
                    {post.data.title}
                  </h2>
                </a>

                {post.data.description && (
                  <p class="text-zinc-600 dark:text-zinc-400 text-sm md:text-base leading-relaxed mb-3">
                    {post.data.description}
                  </p>
                )}

                <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex gap-1.5 flex-wrap">
                      {post.data.tags.map((tag) => (
                        <a href={`/en/tags/${normalizeTag(tag)}`} class="tag">
                          #{tag}
                        </a>
                      ))}
                    </div>
                  )}
                  <a
                    href={postHref}
                    class="text-xs font-semibold text-electric-blue dark:text-electric-blue-light hover:underline inline-flex items-center gap-1"
                  >
                    Read article <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

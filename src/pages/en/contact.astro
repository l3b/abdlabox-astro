---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import socialLinks from '../../data/socialLinks';

const pageTitle = 'Send a Signal';
const pageDescription =
  'We may not know each other, but sometimes, our signals just happen to align.';

const linkCategories = socialLinks.reduce((acc, link) => {
  const category = link.category || 'Other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(link);
  return acc;
}, {} as Record<string, typeof socialLinks>);

const categoryOrder = ['Professional', 'Social', 'Writing', 'Activity', 'Learning', 'Reading', 'Media', 'Other'];
const sortedCategories = Object.keys(linkCategories).sort((a, b) => {
  const ia = categoryOrder.indexOf(a);
  const ib = categoryOrder.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});
---

<BaseLayout title={pageTitle} description={pageDescription} lang="en" dir="ltr">
  <div class="container mx-auto max-w-5xl px-4 md:px-6 py-10 md:py-14">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-4">
        <span class="me-2">📡</span>{pageTitle}
      </h1>
      <p class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        We may not know each other, but sometimes our signals align. Drop a note below, book a quick virtual coffee, or follow my trail across the web.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
      <div class="md:col-span-6 space-y-6">
        <section class="bento-card">
          <h2 class="bento-title mb-4 flex items-center gap-2">
            <span>✍️</span> Signal Form
          </h2>
          <form action="https://formspree.io/f/xgvkewgp" method="POST" class="space-y-4">
            <div>
              <label for="name" class="block mb-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded-xl bg-zinc-50 dark:bg-zinc-950 focus:ring-2 focus:ring-electric-blue focus:border-transparent outline-none"
              />
            </div>
            <div>
              <label for="email" class="block mb-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">Email</label>
              <input
                type="email"
                id="email"
                name="_replyto"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded-xl bg-zinc-50 dark:bg-zinc-950 focus:ring-2 focus:ring-electric-blue focus:border-transparent outline-none"
              />
            </div>
            <div>
              <label for="message" class="block mb-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full px-3.5 py-2.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded-xl bg-zinc-50 dark:bg-zinc-950 focus:ring-2 focus:ring-electric-blue focus:border-transparent outline-none"
              ></textarea>
            </div>
            <button type="submit" class="button w-full sm:w-auto text-sm">Send Signal</button>
          </form>
        </section>

        <section class="bento-card">
          <h2 class="bento-title mb-2 flex items-center gap-2">
            <span>🗓️</span> Schedule a Direct Signal
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4">
            15 or 30 minutes — pick whatever fits your schedule via Cal.com.
          </p>
          <button
            type="button"
            data-cal-link="abdla/30min"
            data-cal-namespace="30min"
            data-cal-config='{"layout":"month_view"}'
            class="button w-full sm:w-auto text-sm self-start"
          >
            Book a Meeting
          </button>
        </section>
      </div>

      <section class="md:col-span-6 bento-card">
        <h2 class="bento-title mb-5 flex items-center gap-2">
          <span>🌐</span> Other Signals
        </h2>
        <div class="space-y-5">
          {sortedCategories.map((category) => (
            <div>
              <h3 class="text-xs font-semibold uppercase text-zinc-400 tracking-wider mb-2.5">
                {category}
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {linkCategories[category].map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer me"
                    class="flex items-center gap-3 p-3 bg-zinc-50/80 dark:bg-zinc-800/50 rounded-xl border border-zinc-200/70 dark:border-zinc-700/60 hover:border-electric-blue/50 transition-all group"
                  >
                    <Icon
                      name={link.icon}
                      class="w-5 h-5 text-electric-blue dark:text-electric-blue-light flex-shrink-0"
                    />
                    <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-electric-blue dark:group-hover:text-electric-blue-light transition-colors">
                      {link.name}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script type="text/javascript" is:inline>
    function initCalEmbed() {
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "30min", {origin:"https://cal.com"});
      Cal.ns["30min"]("ui", {"cssVarsPerTheme":{"light":{"cal-brand":"#0EA5E9"},"dark":{"cal-brand":"#38BDF8"}},"hideEventTypeDetails":false,"layout":"month_view"});
    }
    initCalEmbed();
    document.addEventListener('astro:page-load', initCalEmbed);
  </script>
</BaseLayout>

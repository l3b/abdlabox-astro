# Copy this file to .env and fill in your actual values

# Bluesky API
BLUESKY_APP_PASSWORD="your-app-password-here"
BLUESKY_IDENTIFIER="abdla.box"

# Trakt API (Client ID from https://developer.trakt.tv/)
TRAKT_API_KEY="your-trakt-client-id-here"

# TMDB API (Optional — for movie/TV show posters)
TMDB_API_KEY="your-tmdb-api-key-here"

# Intervals.icu API (Free — Garmin + Strava running stats & gear)
# Get from https://intervals.icu/settings -> Developer Settings
INTERVALS_ATHLETE_ID="i000000"
INTERVALS_API_KEY="your-intervals-api-key-here"

# Cloudflare R2 Images (Optional — defaults to https://img.abdla.box)
R2_BUCKET_URL="https://img.abdla.box"
